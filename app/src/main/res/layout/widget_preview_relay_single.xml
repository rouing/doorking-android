<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/system_accent1_100"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    tools:ignore="HardcodedText">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_lock"
        android:tint="@android:color/system_accent1_900" />

    <TextView
        android:id="@+id/preview_relay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Main Gate"
        android:textColor="@android:color/system_accent1_900"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
